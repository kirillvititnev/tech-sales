# White Shop — local env example
# cp .env.example .env

POSTGRES_USER=whiteshop
POSTGRES_PASSWORD=whiteshop
POSTGRES_DB=whiteshop
DATABASE_URL=postgresql+asyncpg://whiteshop:whiteshop@localhost:5433/whiteshop

REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Telegram MTProto (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session

# Optional proxy for Telegram (empty = direct, OK while abroad).
# On RU VPS with VLESS Reality (compose profile vpn):
#   TELEGRAM_PROXY=socks5://xray:1080
# Or host-side xray ports:
#   TELEGRAM_PROXY=socks5://127.0.0.1:10808
TELEGRAM_PROXY=

# VLESS Reality placeholders (fill infra/vpn/xray.config.json on server; do not commit secrets)
# VPN_SERVER_HOST=
# VPN_UUID=
# VPN_SNI_DOMAIN=
# VPN_PUBLIC_KEY=
# VPN_SHORT_ID=

# Pricing defaults
DEFAULT_MARKUP_PERCENT=10
PRICE_ROUND_TO=100
# Storefront hard floor (offers below this RUB are rejected)
MIN_OFFER_PRICE_RUB=6000

# Parse interval (minutes)
PARSE_INTERVAL_MINUTES=15

NEXT_PUBLIC_API_URL=http://localhost:8000

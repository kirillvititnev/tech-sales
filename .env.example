# White Shop — copy to .env, then run `make env` to fill empty secrets.
# Do not commit .env. Placeholder passwords are rejected at API startup.

POSTGRES_USER=whiteshop
POSTGRES_PASSWORD=
POSTGRES_DB=whiteshop
DATABASE_URL=postgresql+asyncpg://whiteshop:@localhost:5433/whiteshop

REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=
API_DOCS_ENABLED=false
CORS_ORIGINS=http://localhost:3000,https://whiteshop.tech,https://www.whiteshop.tech
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,whiteshop.tech,www.whiteshop.tech,api

# HTTP Basic for /admin and /api/v1/admin (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Telegram MTProto (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session

# Optional proxy for Telegram (empty = direct, OK while abroad).
# On RU VPS with VLESS Reality (compose profile vpn):
#   TELEGRAM_PROXY=socks5://xray:1080
# Or host-side xray ports:
#   TELEGRAM_PROXY=socks5://127.0.0.1:10808
TELEGRAM_PROXY=

# VLESS Reality placeholders (fill infra/vpn/xray.config.json on server; do not commit secrets)
# VPN_SERVER_HOST=
# VPN_UUID=
# VPN_SNI_DOMAIN=
# VPN_PUBLIC_KEY=
# VPN_SHORT_ID=

# Pricing defaults
DEFAULT_MARKUP_PERCENT=10
PRICE_ROUND_TO=100
# Storefront hard floor (offers below this RUB are rejected)
MIN_OFFER_PRICE_RUB=6000

# Parse interval (minutes)
PARSE_INTERVAL_MINUTES=15
# Product photos (admin upload + optional Telegram 1–3 SKU posts)
PRODUCT_IMAGE_DIR=data/product-images

# Empty = browser calls this host (`/api/v1/...`); Next.js rewrites to FastAPI.
NEXT_PUBLIC_API_URL=
# Server-side / rewrite target (local FastAPI).
API_INTERNAL_URL=http://127.0.0.1:8000

# Telegram Mini App (BotFather → Web App URL → https://<host>/mini)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Bot token: same bot can send order alerts to the admin chat.
TELEGRAM_BOT_TOKEN=
# Admin user or group chat id (comma-separated for several). Negative for groups.
# Get a user id via @userinfobot after /start to your shop bot.
ADMIN_TELEGRAM_CHAT_ID=

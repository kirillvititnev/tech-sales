<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install (bootstrap does this):
    cp … ~/Library/LaunchAgents/com.whiteshop.cloudflared.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.whiteshop.cloudflared.plist

  Replace __REPO_ROOT__ with absolute path to tech-sales (tunnel config lives there).
  Replace __CLOUDFLARED__ with absolute path to cloudflared (e.g. /opt/homebrew/bin/cloudflared).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.whiteshop.cloudflared</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED__</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__REPO_ROOT__/infra/tunnel/config.yml</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cloudflared.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cloudflared.err.log</string>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
</dict>
</plist>
